#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
source "$repo/tmux/scripts/runtime.sh"
data="${AARON_TMUX_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/aaron-tmux}"
tmux_exe=$(aaron_tmux_select "$data") || { printf 'Run %s/scripts/setup.sh --only tmux first.\n' "$repo" >&2; exit 1; }
exec "$tmux_exe" "$@"
